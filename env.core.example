# Hanzo Core Stack - Environment Configuration
# Copy to .env.core and configure for your deployment
# Deploy with: docker compose -f compose.core.yml --env-file .env.core up -d

# =============================================================================
# INFRASTRUCTURE
# =============================================================================

# PostgreSQL
POSTGRES_USER=hanzo
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=hanzo
POSTGRES_PORT=5432

# Redis
REDIS_PASSWORD=change-me-in-production
REDIS_PORT=6379

# NATS
NATS_PORT=4222
NATS_HTTP_PORT=8222

# =============================================================================
# CORE SERVICES
# =============================================================================

# 1. Analytics (Umami fork) - Port 3010
ANALYTICS_PORT=3010
ANALYTICS_URL=https://analytics.yourdomain.com
NEXTAUTH_SECRET=generate-a-secure-random-string
ANALYTICS_SECRET=generate-another-secure-string
ANALYTICS_DISABLE_SIGNUPS=false

# 2. Datastore (Hanzo Datastore) - Port 8123
HANZO_HTTP_PORT=8123
HANZO_NATIVE_PORT=9009
HANZO_DB=analytics
HANZO_USER=hanzo
HANZO_PASSWORD=change-me-in-production

# 3. Base (PocketBase fork) - Port 8090
BASE_PORT=8090
BASE_ENCRYPTION_KEY=32-char-encryption-key-here!!!!

# 4. IAM (Casdoor fork) - Port 8000
IAM_PORT=8000
IAM_MODE=prod

# 5. KMS (Infisical fork) - Port 8070
KMS_PORT=8070
KMS_ENCRYPTION_KEY=6de33a4e5d9c57cf9e41b7147a0aff04
KMS_AUTH_SECRET=generate-a-very-long-auth-secret
KMS_URL=https://kms.yourdomain.com

# SMTP for KMS (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=Hanzo KMS

# 6. Commerce (Hanzo Commerce) - Port 8001
COMMERCE_PORT=8001
APP_ENV=production

# Payment Processors
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Email Service
SENDGRID_API_KEY=SG...
EMAIL_FROM=noreply@yourdomain.com

# 7. Marketing (AI Marketing) - Port 8002
MARKETING_PORT=8002
DEBUG=false

# LLM Router (optional, for AI features)
ROUTER_URL=http://router:4000/v1
ROUTER_API_KEY=sk-router-master-hanzo

# Ad Platforms (configure what you use)
META_ACCESS_TOKEN=
META_APP_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
TIKTOK_ACCESS_TOKEN=
TIKTOK_APP_ID=

# SMS/Communication
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Social Media
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# =============================================================================
# DEPLOYMENT (DigitalOcean)
# =============================================================================

# Domain Configuration
DOMAIN=yourdomain.com

# TLS/SSL (when using Platform/Traefik)
LETSENCRYPT_EMAIL=admin@yourdomain.com

# Hanzo Stack Environment Configuration
# Copy this file to .env and update with your values

# ====================
# LLM Provider API Keys
# ====================
# Configure the API keys for the providers you want to use
# The router will automatically detect and enable providers with valid keys

# OpenAI
OPENAI_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# Google (Gemini)
GOOGLE_API_KEY=

# Together AI
TOGETHER_API_KEY=

# Cohere
COHERE_API_KEY=

# Mistral
MISTRAL_API_KEY=

# Perplexity
PERPLEXITY_API_KEY=

# Groq
GROQ_API_KEY=

# Anyscale
ANYSCALE_API_KEY=

# DeepInfra
DEEPINFRA_API_KEY=

# Azure OpenAI
AZURE_API_KEY=
AZURE_API_BASE=
AZURE_API_VERSION=

# AWS Bedrock
BEDROCK_ACCESS_KEY_ID=
BEDROCK_SECRET_ACCESS_KEY=
BEDROCK_REGION=us-east-1

# Google Vertex AI
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=

# ====================
# Database Configuration
# ====================
POSTGRES_USER=hanzo
POSTGRES_PASSWORD=hanzo123
POSTGRES_DB=hanzo
POSTGRES_PORT=5432

MONGO_ROOT_USERNAME=hanzo
MONGO_ROOT_PASSWORD=hanzo123
MONGO_INITDB_DATABASE=hanzo
MONGODB_PORT=27017

REDIS_PASSWORD=hanzo123
REDIS_PORT=6379

# ====================
# Storage Configuration
# ====================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# S3 Configuration for services
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# ====================
# Search Configuration
# ====================
MEILI_MASTER_KEY=hanzo-meili-master
MEILI_ENV=production
MEILI_PORT=7700
MEILI_HOST=http://meilisearch:7700

# ====================
# Service Ports
# ====================
ROUTER_PORT=4000
CHAT_PORT=3081
RUNTIME_PORT=3003
SERVICES_PORT=3000
API_PORT=8000
SEARCH_PORT=3000
IAM_PORT=8080
CLOUD_PORT=3001
MCP_PORT=3004
AGENT_PORT=3005
FLOW_PORT=3006

# ====================
# Service Configuration
# ====================
# Router (LLM Gateway)
ROUTER_MASTER_KEY=sk-router-master-hanzo
ROUTER_MODE=PRODUCTION
ROUTER_UI_USERNAME=admin
ROUTER_UI_PASSWORD=admin

# Chat
NODE_ENV=production
NO_AUTH=false
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CUSTOM_FOOTER=Powered by Hanzo AI
HELP_AND_FAQ_URL=https://docs.hanzo.ai
LIBRECHAT_SHARE_ENABLED=true

# Cloud
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=hanzo-cloud-secret
CLOUD_API_KEY=dev-cloud-key

# API
API_SECRET_KEY=hanzo-api-secret

# Search
SUPABASE_URL=
SUPABASE_ANON_KEY=
TAVILY_API_KEY=
SEARXNG_API_URL=

# Runtime
RUNTIME_API_KEY=dev-runtime-key
MAX_EXECUTION_TIME=30000
MEMORY_LIMIT=512m
ALLOW_UNSAFE_CODE=false
SKIP_AUTH=true

# MCP
WORKSPACE_PATH=./workspace

# ====================
# Feature Flags
# ====================
ENABLE_COST_TRACKING=true
ENABLE_ANALYTICS=true
ENABLE_API_TRACKING=true
ENABLE_USAGE_ANALYTICS=true
ENABLE_CODE_EXECUTION=true
ENABLE_ALL_TOOLS=true
RUNTIME_ENABLED=true
MCP_ENABLED=true

# ====================
# Development Paths (for compose.dev.yml)
# ====================
# Uncomment and adjust if your services are in different locations
# CHAT_PATH=../chat
# LLM_PATH=../llm
# RUNTIME_PATH=../runtime
# SERVICES_PATH=../services/services
# API_PATH=../api
# SEARCH_PATH=../search
# IAM_PATH=../iam
# CLOUD_PATH=../cloud
# MCP_PATH=../mcp
# AGENT_PATH=../agent

# ====================
# Development Tools
# ====================
ADMINER_PORT=8081
REDIS_COMMANDER_PORT=8082

# ====================
# Feature Flags
# ====================
# Enable/disable specific features
RUNTIME_ENABLED=true
MCP_ENABLED=false
AGENT_ENABLED=false

# ====================
# External Service URLs (Production)
# ====================
PRODUCTION_URL=https://hanzo.services
PRODUCTION_IAM=https://hanzo.id
IAM_URL=http://iam:8080
CLOUD_URL=http://cloud:3000
ROUTER_URL=http://llm-gateway:4000
CHAT_URL=http://chat:3081
RUNTIME_URL=http://runtime:3000

# ====================
# Deployment Configuration
# ====================
VERSION=latest
COMPOSE_PROJECT_NAME=hanzo
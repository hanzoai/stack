# Hanzo Stack Environment Configuration
# Copy this file to .env and update with your values

# ====================
# API Keys (Required - at least one)
# ====================
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
TOGETHER_API_KEY=...
GOOGLE_API_KEY=...

# ====================
# Database Configuration
# ====================
POSTGRES_USER=hanzo
POSTGRES_PASSWORD=hanzo123
POSTGRES_DB=hanzo
POSTGRES_PORT=5432

MONGODB_USERNAME=hanzo
MONGODB_PASSWORD=hanzo123
MONGODB_DATABASE=hanzo
MONGODB_PORT=27017

REDIS_PASSWORD=hanzo123
REDIS_PORT=6379

# ====================
# Storage Configuration
# ====================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# S3 Configuration for services
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# ====================
# Search Configuration
# ====================
MEILISEARCH_MASTER_KEY=hanzo123
MEILISEARCH_PORT=7700
MEILI_ENV=development

# ====================
# Service Ports
# ====================
ROUTER_PORT=4000
CHAT_PORT=3081
RUNTIME_PORT=3003
SERVICES_PORT=3000
API_PORT=8000
SEARCH_PORT=3000
IAM_PORT=8080
CLOUD_PORT=3001
MCP_PORT=3004
AGENT_PORT=3005

# ====================
# Service Configuration
# ====================
# LLM Gateway
ROUTER_MASTER_KEY=sk-router-master-hanzo

# Chat
NEXTAUTH_SECRET=dev-secret-please-change-in-production
NODE_ENV=production

# Runtime
RUNTIME_DB=hanzo_runtime
RUNTIME_BUCKET=runtime-storage
RUNTIME_API_KEY=dev-runtime-key
RUNNER_DOMAIN=localtest.me:3003
RUNNER_API_KEY=secret_api_token
SKIP_CONNECTIONS=true
SKIP_AUTH=false

# Services
SERVICES_DB=hanzo_services
SERVICES_PORT=3000

# ====================
# Development Paths (for compose.dev.yml)
# ====================
# Uncomment and adjust if your services are in different locations
# CHAT_PATH=../chat
# LLM_PATH=../llm
# RUNTIME_PATH=../runtime
# SERVICES_PATH=../services/services
# API_PATH=../api
# SEARCH_PATH=../search
# IAM_PATH=../iam
# CLOUD_PATH=../cloud
# MCP_PATH=../mcp
# AGENT_PATH=../agent

# ====================
# Development Tools
# ====================
ADMINER_PORT=8081
REDIS_COMMANDER_PORT=8082

# ====================
# Feature Flags
# ====================
# Enable/disable specific features
RUNTIME_ENABLED=true
MCP_ENABLED=false
AGENT_ENABLED=false

# ====================
# External Service URLs (Production)
# ====================
PRODUCTION_URL=https://hanzo.services
PRODUCTION_IAM=https://hanzo.id
IAM_URL=http://iam:8080
CLOUD_URL=http://cloud:3000
ROUTER_URL=http://llm-gateway:4000
CHAT_URL=http://chat:3081
RUNTIME_URL=http://runtime:3000

# ====================
# Deployment Configuration
# ====================
VERSION=latest
COMPOSE_PROJECT_NAME=hanzo
# Hanzo Stack Development Configuration
# Local development with hot reload

# General
COMPOSE_PROJECT_NAME=hanzo-dev
ENVIRONMENT=development
NODE_ENV=development

# PostgreSQL
POSTGRES_USER=hanzo
POSTGRES_PASSWORD=hanzo123
POSTGRES_DB=hanzo
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379
REDIS_PASSWORD=hanzo123

# MongoDB
MONGODB_PORT=27017
MONGODB_DATABASE=hanzo
MONGODB_USERNAME=hanzo
MONGODB_PASSWORD=hanzo123

# MinIO (S3-compatible storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Meilisearch
MEILISEARCH_PORT=7700
MEILISEARCH_MASTER_KEY=hanzo123
MEILI_ENV=development

# Router
ROUTER_MASTER_KEY=sk-router-master-hanzo
LLM_PORT=4000

# Chat Interface
CHAT_PORT=3081

# LLM Providers (add your keys here)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
TOGETHER_API_KEY=
GOOGLE_API_KEY=

# Authentication
NEXTAUTH_SECRET=dev-secret-please-change-in-production
NEXTAUTH_URL=http://localhost:3081

# Development specific
LOG_LEVEL=debug
DEBUG=true


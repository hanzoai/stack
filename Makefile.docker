# Makefile for Hanzo AI Services Docker Operations
# Provides convenient commands for building, deploying, and managing Docker containers

.PHONY: help build build-dev build-prod up down logs clean prune test health backup

# Default target
.DEFAULT_GOAL := help

# Variables
COMPOSE_FILE := docker-compose.hanzo-services.yml
RUNTIME_DIR := ../runtime
CLOUD_DIR := ../cloud
MCP_DIR := ../mcp
REGISTRY := hanzoai
TAG ?= latest
ENV_FILE ?= .env

# Colors for output
RED := \033[0;31m
GREEN := \033[0;32m
YELLOW := \033[0;33m
BLUE := \033[0;34m
NC := \033[0m # No Color

help: ## Show this help message
	@echo "$(BLUE)Hanzo AI Services - Docker Management$(NC)"
	@echo "======================================"
	@echo ""
	@echo "$(GREEN)Available commands:$(NC)"
	@awk 'BEGIN {FS = ":.*?## "} /^[a-zA-Z_-]+:.*?## / {printf "  $(YELLOW)%-20s$(NC) %s\n", $$1, $$2}' $(MAKEFILE_LIST)
	@echo ""
	@echo "$(GREEN)Environment variables:$(NC)"
	@echo "  $(YELLOW)TAG$(NC)                 Docker image tag (default: latest)"
	@echo "  $(YELLOW)ENV_FILE$(NC)            Environment file (default: .env)"
	@echo "  $(YELLOW)REGISTRY$(NC)            Docker registry (default: hanzoai)"

# Build Commands
build: ## Build all production images
	@echo "$(BLUE)Building production images...$(NC)"
	@docker build --target production -t $(REGISTRY)/runtime:$(TAG) $(RUNTIME_DIR)
	@docker build --target production -t $(REGISTRY)/cloud:$(TAG) $(CLOUD_DIR)
	@docker build --target production -t $(REGISTRY)/mcp:$(TAG) $(MCP_DIR)
	@echo "$(GREEN)✓ All images built successfully$(NC)"

build-dev: ## Build all development images
	@echo "$(BLUE)Building development images...$(NC)"
	@docker build --target development -t $(REGISTRY)/runtime:dev $(RUNTIME_DIR)
	@docker build --target development -t $(REGISTRY)/cloud:dev $(CLOUD_DIR)
	@docker build --target development -t $(REGISTRY)/mcp:dev $(MCP_DIR)
	@echo "$(GREEN)✓ Development images built successfully$(NC)"

build-runtime: ## Build only runtime service
	@echo "$(BLUE)Building runtime service...$(NC)"
	@docker build --target production -t $(REGISTRY)/runtime:$(TAG) $(RUNTIME_DIR)
	@echo "$(GREEN)✓ Runtime image built successfully$(NC)"

build-cloud: ## Build only cloud service
	@echo "$(BLUE)Building cloud service...$(NC)"
	@docker build --target production -t $(REGISTRY)/cloud:$(TAG) $(CLOUD_DIR)
	@echo "$(GREEN)✓ Cloud image built successfully$(NC)"

build-mcp: ## Build only MCP service
	@echo "$(BLUE)Building MCP service...$(NC)"
	@docker build --target production -t $(REGISTRY)/mcp:$(TAG) $(MCP_DIR)
	@echo "$(GREEN)✓ MCP image built successfully$(NC)"

build-no-cache: ## Build all images without cache
	@echo "$(BLUE)Building images without cache...$(NC)"
	@docker build --no-cache --target production -t $(REGISTRY)/runtime:$(TAG) $(RUNTIME_DIR)
	@docker build --no-cache --target production -t $(REGISTRY)/cloud:$(TAG) $(CLOUD_DIR)
	@docker build --no-cache --target production -t $(REGISTRY)/mcp:$(TAG) $(MCP_DIR)
	@echo "$(GREEN)✓ All images built successfully$(NC)"

# Deployment Commands
up: ## Start all services
	@echo "$(BLUE)Starting Hanzo AI services...$(NC)"
	@docker compose -f $(COMPOSE_FILE) --env-file $(ENV_FILE) up -d
	@echo "$(GREEN)✓ Services started successfully$(NC)"
	@$(MAKE) health

up-build: ## Build and start all services
	@echo "$(BLUE)Building and starting services...$(NC)"
	@docker compose -f $(COMPOSE_FILE) --env-file $(ENV_FILE) up -d --build
	@echo "$(GREEN)✓ Services built and started successfully$(NC)"
	@$(MAKE) health

down: ## Stop all services
	@echo "$(BLUE)Stopping Hanzo AI services...$(NC)"
	@docker compose -f $(COMPOSE_FILE) down
	@echo "$(GREEN)✓ Services stopped successfully$(NC)"

restart: ## Restart all services
	@echo "$(BLUE)Restarting Hanzo AI services...$(NC)"
	@docker compose -f $(COMPOSE_FILE) restart
	@echo "$(GREEN)✓ Services restarted successfully$(NC)"

# Monitoring Commands
logs: ## Show logs for all services
	@docker compose -f $(COMPOSE_FILE) logs -f

logs-runtime: ## Show logs for runtime service
	@docker compose -f $(COMPOSE_FILE) logs -f hanzo-runtime

logs-cloud: ## Show logs for cloud service
	@docker compose -f $(COMPOSE_FILE) logs -f hanzo-cloud

logs-mcp: ## Show logs for MCP service
	@docker compose -f $(COMPOSE_FILE) logs -f hanzo-mcp

status: ## Show service status
	@echo "$(BLUE)Service Status:$(NC)"
	@docker compose -f $(COMPOSE_FILE) ps

health: ## Check health of all services
	@echo "$(BLUE)Checking service health...$(NC)"
	@echo "$(YELLOW)Runtime Service:$(NC)"
	@docker inspect --format='{{.State.Health.Status}}' hanzo-runtime 2>/dev/null || echo "Not running"
	@echo "$(YELLOW)Cloud Service:$(NC)"
	@docker inspect --format='{{.State.Health.Status}}' hanzo-cloud 2>/dev/null || echo "Not running"
	@echo "$(YELLOW)MCP Service:$(NC)"
	@docker inspect --format='{{.State.Health.Status}}' hanzo-mcp 2>/dev/null || echo "Not running"
	@echo "$(YELLOW)PostgreSQL:$(NC)"
	@docker inspect --format='{{.State.Health.Status}}' hanzo-postgres 2>/dev/null || echo "Not running"
	@echo "$(YELLOW)Redis:$(NC)"
	@docker inspect --format='{{.State.Health.Status}}' hanzo-redis 2>/dev/null || echo "Not running"

stats: ## Show container resource usage
	@docker stats hanzo-runtime hanzo-cloud hanzo-mcp hanzo-postgres hanzo-redis --no-stream

# Development Commands
shell-runtime: ## Open shell in runtime container
	@docker exec -it hanzo-runtime /bin/sh

shell-cloud: ## Open shell in cloud container
	@docker exec -it hanzo-cloud /bin/sh

shell-mcp: ## Open shell in MCP container
	@docker exec -it hanzo-mcp /bin/sh

shell-postgres: ## Open PostgreSQL shell
	@docker exec -it hanzo-postgres psql -U hanzo_user -d hanzo

shell-redis: ## Open Redis CLI
	@docker exec -it hanzo-redis redis-cli

# Testing Commands
test: ## Run health checks and basic tests
	@echo "$(BLUE)Running service tests...$(NC)"
	@curl -f http://localhost:3000/health || (echo "$(RED)✗ Runtime health check failed$(NC)" && exit 1)
	@curl -f http://localhost:3001/api/health || (echo "$(RED)✗ Cloud health check failed$(NC)" && exit 1)
	@echo "$(GREEN)✓ All health checks passed$(NC)"

test-runtime: ## Test runtime service
	@curl -f http://localhost:3000/health || (echo "$(RED)✗ Runtime service test failed$(NC)" && exit 1)
	@echo "$(GREEN)✓ Runtime service test passed$(NC)"

test-cloud: ## Test cloud service
	@curl -f http://localhost:3001/api/health || (echo "$(RED)✗ Cloud service test failed$(NC)" && exit 1)
	@echo "$(GREEN)✓ Cloud service test passed$(NC)"

# Maintenance Commands
clean: ## Remove all containers and images
	@echo "$(BLUE)Cleaning up Docker resources...$(NC)"
	@docker compose -f $(COMPOSE_FILE) down -v --remove-orphans
	@docker rmi $(REGISTRY)/runtime:$(TAG) $(REGISTRY)/cloud:$(TAG) $(REGISTRY)/mcp:$(TAG) 2>/dev/null || true
	@echo "$(GREEN)✓ Cleanup completed$(NC)"

prune: ## Remove unused Docker resources
	@echo "$(BLUE)Pruning unused Docker resources...$(NC)"
	@docker system prune -af --volumes
	@echo "$(GREEN)✓ Pruning completed$(NC)"

update: ## Pull latest base images and rebuild
	@echo "$(BLUE)Updating base images...$(NC)"
	@docker pull node:20-alpine
	@docker pull postgres:16-alpine
	@docker pull redis:7-alpine
	@$(MAKE) build-no-cache
	@echo "$(GREEN)✓ Update completed$(NC)"

# Backup Commands
backup-db: ## Backup PostgreSQL database
	@echo "$(BLUE)Backing up PostgreSQL database...$(NC)"
	@mkdir -p ./backups
	@docker exec hanzo-postgres pg_dump -U hanzo_user hanzo > ./backups/postgres-backup-$(shell date +%Y%m%d_%H%M%S).sql
	@echo "$(GREEN)✓ Database backup completed$(NC)"

backup-redis: ## Backup Redis data
	@echo "$(BLUE)Backing up Redis data...$(NC)"
	@mkdir -p ./backups
	@docker exec hanzo-redis redis-cli BGSAVE
	@sleep 2
	@docker cp hanzo-redis:/data/dump.rdb ./backups/redis-backup-$(shell date +%Y%m%d_%H%M%S).rdb
	@echo "$(GREEN)✓ Redis backup completed$(NC)"

backup-volumes: ## Backup Docker volumes
	@echo "$(BLUE)Backing up Docker volumes...$(NC)"
	@mkdir -p ./backups
	@docker run --rm -v hanzo-postgres-data:/data -v $(PWD)/backups:/backup alpine tar czf /backup/postgres-volume-$(shell date +%Y%m%d_%H%M%S).tar.gz /data
	@docker run --rm -v hanzo-redis-data:/data -v $(PWD)/backups:/backup alpine tar czf /backup/redis-volume-$(shell date +%Y%m%d_%H%M%S).tar.gz /data
	@echo "$(GREEN)✓ Volume backups completed$(NC)"

backup-all: backup-db backup-redis backup-volumes ## Backup all data

# Registry Commands
push: ## Push images to registry
	@echo "$(BLUE)Pushing images to registry...$(NC)"
	@docker push $(REGISTRY)/runtime:$(TAG)
	@docker push $(REGISTRY)/cloud:$(TAG)
	@docker push $(REGISTRY)/mcp:$(TAG)
	@echo "$(GREEN)✓ Images pushed successfully$(NC)"

pull: ## Pull images from registry
	@echo "$(BLUE)Pulling images from registry...$(NC)"
	@docker pull $(REGISTRY)/runtime:$(TAG)
	@docker pull $(REGISTRY)/cloud:$(TAG)
	@docker pull $(REGISTRY)/mcp:$(TAG)
	@echo "$(GREEN)✓ Images pulled successfully$(NC)"

# Security Commands
scan: ## Scan images for vulnerabilities
	@echo "$(BLUE)Scanning images for vulnerabilities...$(NC)"
	@command -v trivy >/dev/null 2>&1 || (echo "$(RED)Trivy not installed. Install: https://aquasecurity.github.io/trivy/$(NC)" && exit 1)
	@trivy image $(REGISTRY)/runtime:$(TAG)
	@trivy image $(REGISTRY)/cloud:$(TAG)
	@trivy image $(REGISTRY)/mcp:$(TAG)

# Environment Commands
env-check: ## Check environment configuration
	@echo "$(BLUE)Checking environment configuration...$(NC)"
	@test -f $(ENV_FILE) || (echo "$(RED)✗ Environment file $(ENV_FILE) not found$(NC)" && exit 1)
	@echo "$(GREEN)✓ Environment file found$(NC)"
	@grep -q "POSTGRES_PASSWORD" $(ENV_FILE) || (echo "$(YELLOW)⚠ POSTGRES_PASSWORD not set$(NC)")
	@grep -q "NEXTAUTH_SECRET" $(ENV_FILE) || (echo "$(YELLOW)⚠ NEXTAUTH_SECRET not set$(NC)")
	@echo "$(GREEN)✓ Environment check completed$(NC)"

env-template: ## Create environment template
	@echo "$(BLUE)Creating environment template...$(NC)"
	@cat > .env.template << 'EOF'
# Database Configuration
POSTGRES_DB=hanzo
POSTGRES_USER=hanzo_user
POSTGRES_PASSWORD=secure_password_here
DATABASE_URL=postgresql://hanzo_user:secure_password_here@postgres:5432/hanzo

# Redis Configuration
REDIS_PASSWORD=redis_password_here
REDIS_URL=redis://:redis_password_here@redis:6379

# Authentication
NEXTAUTH_URL=https://cloud.hanzo.ai
NEXTAUTH_SECRET=your-super-secret-key-here

# SSL/TLS
DOMAIN=hanzo.ai
ACME_EMAIL=admin@hanzo.ai

# Ports (optional overrides)
POSTGRES_PORT=5432
REDIS_PORT=6379
EOF
	@echo "$(GREEN)✓ Environment template created as .env.template$(NC)"

# Documentation Commands
docs: ## Show service documentation
	@echo "$(BLUE)Hanzo AI Services Documentation$(NC)"
	@echo "================================"
	@echo ""
	@echo "$(GREEN)Service Endpoints:$(NC)"
	@echo "  Runtime API:      http://localhost:3000"
	@echo "  Cloud Dashboard:  http://localhost:3001"
	@echo "  Traefik Dashboard: http://localhost:8080"
	@echo ""
	@echo "$(GREEN)Database Connections:$(NC)"
	@echo "  PostgreSQL:       localhost:5432"
	@echo "  Redis:            localhost:6379"
	@echo ""
	@echo "$(GREEN)For detailed documentation, see:$(NC)"
	@echo "  DOCKER_DEPLOYMENT.md"

# Quick commands
quick-start: env-check build up ## Quick start (check env, build, and start services)
	@echo "$(GREEN)🚀 Hanzo AI services are now running!$(NC)"
	@echo "  Runtime API: http://localhost:3000"
	@echo "  Cloud Dashboard: http://localhost:3001"

dev: build-dev up ## Start development environment
	@echo "$(GREEN)🔧 Development environment is ready!$(NC)"
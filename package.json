{
  "name": "hanzo-stack-tests",
  "version": "1.0.0",
  "description": "Integration tests for Hanzo AI Stack",
  "scripts": {
    "test": "vitest -c tests/vitest.config.ts",
    "test:integration": "./tests/run-integration-tests.sh",
    "test:router": "vitest -c tests/vitest.config.ts tests/integration/router.test.js",
    "test:ide": "vitest -c tests/vitest.config.ts tests/integration/ide.test.js",
    "test:stack": "vitest -c tests/vitest.config.ts tests/integration/full-stack.test.js",
    "test:watch": "vitest -c tests/vitest.config.ts --watch"
  },
  "devDependencies": {
    "vitest": "^2.1.3",
    "node-fetch": "^2.7.0"
  }
}
